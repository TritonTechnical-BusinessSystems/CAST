# CAST API configuration. Copy to `.env` and fill in. NEVER commit the real .env.
NODE_ENV=development
CAST_API_PORT=3001

# --- Session (JWT cookie) ---
# Generate: openssl rand -hex 32
CAST_JWT_SECRET=
CAST_JWT_EXPIRES_IN=8h

# --- Active Directory (LDAPS) — primary login, mechanism still open (INIT-0008) ---
# On trt-cast-01's intended network the DCs are 10.20.30.208 / .209.
CAST_LDAP_URL=ldaps://10.20.30.208:636
CAST_LDAP_BASE_DN=DC=triton,DC=local
CAST_LDAP_BIND_DN=CN=cast-svc,OU=Service Accounts,DC=triton,DC=local
CAST_LDAP_BIND_PASSWORD=
# "CAST Users" group — membership REQUIRED to sign in.
CAST_LDAP_ALLOWED_GROUP_DN=CN=CAST Users,OU=Groups,DC=triton,DC=local

# --- Local break-glass admin "TritonAdmin" ---
# Set this to control the TritonAdmin password from first boot. If left
# blank, the account seeds with an unknown, unlogged random password —
# nothing can sign in yet. That's deliberate (2026-08-21): this app never
# auto-arms a bypass unattended. To bootstrap access, run the same manual
# reset procedure any locked-out local account uses
# (knowledge/architecture/cast-web-app-auth.md) — an admin arms a
# time-bound window and signs in within it.
CAST_BREAKGLASS_PASSWORD=

# --- Vessel Location Updating (INIT-0012) ---
# Boot-time seed for how often the AIS-monitor Tier 1/2 split recomputes
# (minutes). Runtime-adjustable without a redeploy via
# PUT /api/tracking/refresh-interval once the app is running.
CAST_TRACKING_REFRESH_MINUTES=5
# Boot-time seed for how many days a confidence-tiered Vessel Site write keeps
# presuming/distrusting a stale status before reverting to a bare "Vessel"
# (vessels/confidence.ts). Runtime-adjustable, same pattern as above.
CAST_VESSEL_STATUS_FALLBACK_DAYS=90

# --- aisstream.io (AIS data source, INIT-0012) ---
# WebSocket API. Docs + architecture:
#   knowledge/architecture/vessel-location-updating-aisstream.md
# NOT set via env anymore (removed 2026-08-20) — the key and WS URL live ONLY
# in the encrypted store now, entered via the Integrations page. See
# integrations/simpleCreds.ts / vessels/aisListener.ts — no env-sourced
# fallback, and saving a key starts the listener immediately (no redeploy).

# --- ConnectWise PSA (Manage) REST API (INIT-0002/0012/0014) ---
# Credentialed CW read+write. Pattern: knowledge/architecture/connectwise-api-integration.md
# Use a DEDICATED API Member for CAST (not shared with other integrations).
# NOT set via env anymore (removed 2026-08-19) — every instance's credentials
# (company/public key/private key/client id/base URL) live ONLY in the
# encrypted per-instance store now, entered via the Integrations page. See
# connectwise/creds.ts — there is deliberately no env-sourced fallback.
# Company custom-field captions holding the vessel identifiers
# (verified live 2026-07-23 — the real captions are "Vessel IMO" / "Vessel MMSI"):
CW_IMO_FIELD_CAPTION=Vessel IMO
CW_MMSI_FIELD_CAPTION=Vessel MMSI
# Site custom-field caption for the confidence-tiered write's timestamp
# (verified live 2026-08-17 — a "Text" type field on the Site, not the Company):
CW_LAST_AIS_UPDATE_FIELD_CAPTION=Last AIS Data Update
# Ticket custom-field caption whose picklist is Logistics' live Carriers list
# (verified live 2026-08-19 — id 70, 14 options, e.g. "DHL Express", "UPS"):
CW_CARRIER_FIELD_CAPTION=Shipment Carrier
# CW company status that further scopes tracking (optional; leave blank = any):
CW_TRACKED_STATUS=
# A vessel = any company whose CW Market contains this (regardless of IMO/MMSI):
CW_VESSEL_MARKET=Yacht
# HARD SAFETY GATE, PER CW INSTANCE (2026-08-20): no env var controls this
# anymore — every instance starts with writes OFF and is toggled per instance
# from the Integrations page, stored in the DB (`cwWritesEnabled:{instanceId}`
# setting key). There is no deploy/environment-level override.

# --- TrackingMore (shipment tracking data source, INIT-0018 — not yet built) ---
# Docs: https://www.trackingmore.com/docs/trackingmore/
# NOT set via env anymore (removed 2026-08-20) — the key and base URL live
# ONLY in the encrypted store now, entered via the Integrations page. See
# integrations/simpleCreds.ts / integrations/trackingmore.ts.

# --- Internal PDF render target (Commercial Invoice/Packing List, INIT-0026 Phase 3) ---
# Where the api container's headless Chromium reaches the live SPA to render
# print pages. Default matches docker-compose.yml's internal-only nginx 8080
# listener (nginx.conf) — only override for local dev without Docker, e.g.
# CAST_INTERNAL_WEB_URL=http://localhost:5173 against the Vite dev server.
CAST_INTERNAL_WEB_URL=http://web:8080

# --- Deploy agent (System Health "Redeploy" buttons, INIT-0035) ---
# Shared secret between this container and the deploy-agent container ONLY —
# never sent to the browser, never used for anything else. Leave blank in
# local dev (no deploy-agent container there) — the deploy UI just hides
# itself. Generate a real value for a real deploy: `openssl rand -hex 32`.
# api and deploy-agent must have the IDENTICAL value — set once in the SAME
# .env this file becomes (docker-compose.yml reads it for both services).
DEPLOY_AGENT_TOKEN=
# Where cast-api reaches the agent — the Docker Compose service name, not a
# real host. No reason to override outside docker-compose.yml's own network.
CAST_DEPLOY_AGENT_URL=http://deploy-agent:4001
